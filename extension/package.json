{
  "name": "@openvault/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs",
    "build": "node scripts/generate-icons.mjs && vite build && vite build --config vite.content.config.ts && vite build --config vite.webauthn.config.ts && vite build --config vite.background.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openvault/crypto-core": "0.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.1.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.1"
  }
}
